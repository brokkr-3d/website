---
import "~/styles/global.css";
import SEO from "~/components/SEO.astro";
import Header from "~/components/Header.astro";
import Footer from "~/components/Footer.astro";
import { useT, withBase, type Locale, type Section } from "~/lib/i18n";

interface Props {
  locale: Locale;
  title: string;
  description: string;
  active?: Section;
  ogImage?: string;
  noindex?: boolean;
}

const { locale, title, description, active, ogImage, noindex } = Astro.props;
const t = useT(locale);
---

<!doctype html>
<html lang={locale === "no" ? "nb" : "en"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />
    <meta name="theme-color" content="#1a1815" />
    <SEO
      locale={locale}
      title={title}
      description={description}
      ogImage={ogImage}
      noindex={noindex}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">{t("a11y.skip")}</a>
    <Header locale={locale} active={active} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
