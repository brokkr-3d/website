---
import BaseLayout from "~/layouts/BaseLayout.astro";
import { homeHref, useT } from "~/lib/i18n";

const locale = "en";
const t = useT(locale);
---

<BaseLayout locale={locale} title={t("notFound.heading")} description={t("notFound.body")} noindex>
  <section class="section container container--narrow not-found">
    <p class="eyebrow">404</p>
    <h1>{t("notFound.heading")}</h1>
    <p class="lede">{t("notFound.body")}</p>
    <p><a class="button" href={homeHref(locale)}>{t("notFound.back")}</a></p>
  </section>
</BaseLayout>

<style>
  .not-found {
    padding-block: var(--space-3xl);
  }
  .not-found h1 {
    margin-top: var(--space-m);
  }
  .not-found .lede {
    margin-top: var(--space-m);
  }
  .not-found p:last-child {
    margin-top: var(--space-l);
  }
</style>
