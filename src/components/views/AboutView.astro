---
import { Image } from "astro:assets";
import BaseLayout from "~/layouts/BaseLayout.astro";
import TeamGrid from "~/components/TeamGrid.astro";
import { useT, type Locale } from "~/lib/i18n";
// src/assets/about/hero.jpg — swap the file to change the photo.
import heroPhoto from "~/assets/about/hero.jpg";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);

const statement =
  locale === "no"
    ? [
        "Brokkr er oppkalt etter dvergen og mestersmeden i norrøn mytologi. Vi er et lite verksted i Oslo som tror på lokal produksjon, ærlig håndverk og materialer som varer.",
        "Vi jobber i skjæringspunktet mellom design, ingeniørfag og storskala 3D-print — fra første samtale til ferdig produksjonsserie.",
      ]
    : [
        "Brokkr is named after the dwarf and master smith of Norse mythology. We are a small Oslo workshop that believes in local production, honest craft and materials that last.",
        "We work where design, engineering and large-format 3D printing meet — from the first conversation to a finished production run.",
      ];
---

<BaseLayout
  locale={locale}
  active="about"
  title={t("about.heading")}
  description={statement[0]}
>
  <section class="section container">
    <header class="page-head">
      <p class="eyebrow">{t("about.heading")}</p>
      <div class="prose lede-prose">
        {statement.map((p) => <p>{p}</p>)}
      </div>
    </header>

    <Image
      class="about-hero"
      src={heroPhoto}
      alt="Alf Petter and a colleague fitting 3D-printed parts on site"
      widths={[480, 720, 960, 1440]}
      sizes="(min-width: 40rem) 32rem, 88vw"
      loading="lazy"
    />

    <TeamGrid locale={locale} />
  </section>
</BaseLayout>

<style>
  .page-head {
    margin-bottom: var(--space-2xl);
  }
  .page-head .eyebrow {
    margin-bottom: var(--space-m);
  }
  .lede-prose {
    font-size: var(--step-1);
    line-height: var(--leading-snug);
    color: var(--ink);
    max-width: 40ch;
  }
  .about-hero {
    display: block;
    width: 100%;
    max-width: 32rem;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    background: var(--paper-dim);
    border-radius: var(--radius);
    margin-bottom: var(--space-3xl);
  }
</style>
