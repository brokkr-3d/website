---
import { Image } from "astro:assets";
import BaseLayout from "~/layouts/BaseLayout.astro";
import { getTeam, localizeTeam } from "~/lib/content";
import { useT, type Locale } from "~/lib/i18n";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
const team = (await getTeam()).map((m) => localizeTeam(m, locale));

const statement =
  locale === "no"
    ? [
        "Brokkr er oppkalt etter dvergen og mestersmeden i norrøn mytologi. Vi er et lite verksted i Oslo som tror på lokal produksjon, ærlig håndverk og materialer som varer.",
        "Vi jobber i skjæringspunktet mellom design, ingeniørfag og storskala 3D-print — fra første samtale til ferdig produksjonsserie.",
      ]
    : [
        "Brokkr is named after the dwarf and master smith of Norse mythology. We are a small Oslo workshop that believes in local production, honest craft and materials that last.",
        "We work where design, engineering and large-format 3D printing meet — from the first conversation to a finished production run.",
      ];
---

<BaseLayout
  locale={locale}
  active="about"
  title={t("about.heading")}
  description={statement[0]}
>
  <section class="section container">
    <header class="page-head">
      <p class="eyebrow">{t("about.heading")}</p>
      <div class="prose lede-prose">
        {statement.map((p) => <p>{p}</p>)}
      </div>
    </header>

    {
      team.length > 0 && (
        <div class="team">
          <h2 class="team__heading">{t("about.teamHeading")}</h2>
          <ul class="team__grid">
            {team.map((m) => (
              <li class="member">
                {m.photo && (
                  <Image
                    class="member__photo"
                    src={m.photo}
                    alt={m.name}
                    widths={[240, 400, 600]}
                    sizes="(min-width: 40rem) 18rem, 45vw"
                  />
                )}
                <p class="member__name">{m.name}</p>
                <p class="member__role">{m.role}</p>
                {m.bio && <p class="member__bio">{m.bio}</p>}
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </section>
</BaseLayout>

<style>
  .page-head {
    margin-bottom: var(--space-3xl);
  }
  .page-head .eyebrow {
    margin-bottom: var(--space-m);
  }
  .lede-prose {
    font-size: var(--step-1);
    line-height: var(--leading-snug);
    color: var(--ink);
    max-width: 40ch;
  }
  .team__heading {
    font-family: var(--font-sans);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: var(--space-l);
    padding-bottom: var(--space-s);
    border-bottom: var(--border);
  }
  .team__grid {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-xl) var(--space-l);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
  }
  .member__photo {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    background: var(--paper-dim);
    border-radius: var(--radius);
    margin-bottom: var(--space-s);
  }
  .member__name {
    font-size: var(--step-1);
  }
  .member__role {
    font-family: var(--font-sans);
    font-size: var(--step--2);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-top: var(--space-3xs);
  }
  .member__bio {
    margin-top: var(--space-s);
    color: var(--ink-soft);
    font-size: var(--step-0);
    line-height: var(--leading-snug);
  }
</style>
