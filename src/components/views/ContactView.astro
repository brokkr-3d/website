---
import BaseLayout from "~/layouts/BaseLayout.astro";
import { SITE } from "~/config/site";
import { useT, type Locale } from "~/lib/i18n";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
const country = locale === "no" ? SITE.address.country.no : SITE.address.country.en;

const blurb =
  locale === "no"
    ? "Har du et prosjekt, en idé eller bare et spørsmål? Send oss en melding — vi svarer raskt."
    : "Have a project, an idea or just a question? Send us a message — we reply quickly.";

// Map — OpenStreetMap embed (no cookies / tracking); the address links out to
// the Google Maps place page.
const { lat, lng } = SITE.address.coords;
const d = 0.0055;
const bbox = [lng - d * 1.7, lat - d, lng + d * 1.7, lat + d].join("%2C");
const osmSrc = `https://www.openstreetmap.org/export/embed.html?bbox=${bbox}&layer=mapnik&marker=${lat}%2C${lng}`;

// Contact form — posts to Web3Forms (no backend). Set SITE.web3formsKey;
// empty = form hidden, contact page falls back to email only.
const formKey: string = SITE.web3formsKey;

const formStrings = {
  sending: t("contact.form.sending"),
  success: t("contact.form.success"),
  error: t("contact.form.error"),
};
---

<BaseLayout
  locale={locale}
  active="contact"
  title={t("contact.heading")}
  description={blurb}
>
  <section class="section container container--narrow">
    <p class="eyebrow">{t("contact.heading")}</p>
    <h1>{t("contact.cta")}</h1>
    <p class="lede">{blurb}</p>

    <dl class="contact-details">
      <div>
        <dt>Email</dt>
        <dd><a href={`mailto:${SITE.email}`}>{SITE.email}</a></dd>
      </div>
      <div>
        <dt>{t("project.location")}</dt>
        <dd>
          <a href={SITE.address.mapUrl} target="_blank" rel="noopener">
            {SITE.address.street}<br />
            {SITE.address.postal}, {country}
          </a>
        </dd>
      </div>
      <div>
        <dt>Social</dt>
        <dd>
          {
            SITE.socials.map((s) => (
              <a href={s.href} target="_blank" rel="me noopener">
                {s.label}
              </a>
            ))
          }
        </dd>
      </div>
    </dl>

    <figure class="map">
      <iframe
        src={osmSrc}
        title="Map showing Brokkr's location in Oslo"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
      <figcaption>
        <a href={SITE.address.mapUrl} target="_blank" rel="noopener">
          {t("contact.mapLink")} &rarr;
        </a>
      </figcaption>
    </figure>

    <div class="form-block">
      <h2 class="form-heading">{t("contact.formHeading")}</h2>

      {
        formKey ? (
          <form
            class="cform"
            action="https://api.web3forms.com/submit"
            method="POST"
            data-contact-form
          >
            <input type="hidden" name="access_key" value={formKey} />
            <input type="hidden" name="from_name" value="brokkr.design" />
            <input
              type="hidden"
              name="subject"
              value="New message via brokkr.design"
            />
            <input
              type="checkbox"
              name="botcheck"
              class="cform__hp"
              tabindex="-1"
              autocomplete="off"
              aria-hidden="true"
            />

            <p class="cform__field">
              <label for="cf-name">{t("contact.form.name")}</label>
              <input id="cf-name" type="text" name="name" required autocomplete="name" />
            </p>
            <p class="cform__field">
              <label for="cf-email">{t("contact.form.email")}</label>
              <input
                id="cf-email"
                type="email"
                name="email"
                required
                autocomplete="email"
              />
            </p>
            <p class="cform__field">
              <label for="cf-msg">{t("contact.form.message")}</label>
              <textarea id="cf-msg" name="message" rows="6" required />
            </p>

            <button type="submit" class="button">
              {t("contact.form.send")}
            </button>
            <p class="cform__status" data-status role="status" aria-live="polite" />
          </form>
        ) : (
          <p class="form-note">
            {t("contact.form.disabled")}{" "}
            <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
          </p>
        )
      }
    </div>
  </section>
</BaseLayout>

<script is:inline define:vars={{ formStrings }}>
  const form = document.querySelector("[data-contact-form]");
  if (form) {
    const status = form.querySelector("[data-status]");
    const btn = form.querySelector('button[type="submit"]');
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (form.botcheck && form.botcheck.checked) return;
      btn.disabled = true;
      status.className = "cform__status";
      status.textContent = formStrings.sending;
      try {
        const res = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: { Accept: "application/json" },
        });
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.success) {
          form.reset();
          status.textContent = formStrings.success;
          status.classList.add("is-ok");
        } else {
          throw new Error(data.message || "failed");
        }
      } catch {
        status.textContent = formStrings.error;
        status.classList.add("is-err");
      } finally {
        btn.disabled = false;
      }
    });
  }
</script>

<style>
  h1 {
    margin-top: var(--space-m);
  }
  .lede {
    margin-top: var(--space-m);
  }
  .contact-details {
    margin-top: var(--space-2xl);
    border-top: var(--border);
  }
  .contact-details > div {
    display: grid;
    grid-template-columns: minmax(6rem, 10rem) 1fr;
    gap: var(--space-s);
    padding-block: var(--space-m);
    border-bottom: var(--border);
  }
  .contact-details dt {
    font-family: var(--font-sans);
    font-size: var(--step--2);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .contact-details dd {
    margin: 0;
    line-height: 1.8;
  }
  .contact-details dd > a {
    display: inline-block;
    margin-right: var(--space-s);
  }

  .map {
    margin: var(--space-2xl) 0 0;
  }
  .map iframe {
    width: 100%;
    height: clamp(16rem, 42vh, 24rem);
    border: var(--border);
    border-radius: var(--radius);
    display: block;
    filter: saturate(0.85);
  }
  .map figcaption {
    margin-top: var(--space-s);
    font-family: var(--font-sans);
    font-size: var(--step--1);
  }
  .map figcaption a {
    text-decoration: none;
    color: var(--ink-soft);
  }
  .map figcaption a:hover {
    color: var(--accent);
  }

  .form-block {
    margin-top: var(--space-3xl);
  }
  .form-heading {
    font-family: var(--font-sans);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: var(--space-l);
    padding-bottom: var(--space-s);
    border-bottom: var(--border);
  }
  .form-note {
    color: var(--ink-soft);
  }

  .cform {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
    max-width: 34rem;
  }
  .cform__hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  .cform__field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }
  .cform__field label {
    font-family: var(--font-sans);
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
  .cform input,
  .cform textarea {
    font-family: var(--font-sans);
    font-size: var(--step-0);
    padding: 0.7em 0.85em;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--paper-raised);
    color: var(--ink);
  }
  .cform input:focus-visible,
  .cform textarea:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
    border-color: var(--accent);
  }
  .cform textarea {
    resize: vertical;
    min-height: 7rem;
  }
  .cform button {
    align-self: flex-start;
  }
  .cform button[disabled] {
    opacity: 0.6;
    cursor: progress;
  }
  .cform__status {
    font-family: var(--font-sans);
    font-size: var(--step--1);
    min-height: 1.4em;
    margin: 0;
  }
  .cform__status.is-ok {
    color: var(--accent);
  }
  .cform__status.is-err {
    color: #a4262c;
  }

  @media (max-width: 34rem) {
    .contact-details > div {
      grid-template-columns: 1fr;
      gap: var(--space-3xs);
    }
  }
</style>
