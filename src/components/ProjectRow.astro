---
import { Image } from "astro:assets";
import { type ProjectEntry, projectSlug, projectMedia } from "~/lib/content";
import { sectionHref, type Locale } from "~/lib/i18n";
import { categoryLabel } from "~/config/taxonomy";
import placeholder from "~/assets/_placeholder.svg";

interface Props {
  project: ProjectEntry;
  locale: Locale;
  /** position in the list — drives the left/right alternation */
  index?: number;
  /** eager-load above-the-fold rows */
  priority?: boolean;
}
const { project, locale, index = 0, priority = false } = Astro.props;
const { title, categories } = project.data;
const slug = projectSlug(project);
const cover = projectMedia(slug).cover ?? placeholder;
const href = sectionHref(locale, "projects", slug);
const flip = index % 2 === 1;
---

<article class:list={["prow", { "is-flipped": flip }]}>
  <a class="prow__link" href={href}>
    <span class="prow__media">
      <Image
        src={cover}
        alt={title}
        widths={[640, 960, 1280, 1600]}
        sizes="(min-width: 60rem) 58vw, 100vw"
        loading={priority ? "eager" : "lazy"}
      />
    </span>
    <span class="prow__body">
      <span class="prow__title">{title}</span>
      <span class="prow__rule" aria-hidden="true"></span>
      {
        categories.length > 0 && (
          <span class="prow__tags">
            {categories.map((c, i) => (
              <>
                {i > 0 && (
                  <span class="prow__sep" aria-hidden="true">
                    \\
                  </span>
                )}
                <span>{categoryLabel(c, locale)}</span>
              </>
            ))}
          </span>
        )
      }
    </span>
  </a>
</article>

<style>
  .prow__link {
    display: grid;
    gap: var(--space-m);
    text-decoration: none;
    color: inherit;
  }
  .prow__media {
    display: block;
    overflow: hidden;
    background: var(--paper-dim);
    aspect-ratio: 3 / 2;
    border-radius: var(--radius);
  }
  .prow__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms cubic-bezier(0.2, 0, 0, 1);
  }
  .prow__link:hover .prow__media :global(img) {
    transform: scale(1.035);
  }

  .prow__body {
    display: block;
  }
  .prow__title {
    display: block;
    font-family: var(--font-serif);
    font-size: var(--step-2);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
    text-wrap: balance;
  }
  .prow__link:hover .prow__title {
    color: var(--accent);
  }
  .prow__rule {
    display: block;
    width: 2.5rem;
    height: 1px;
    background: var(--ink);
    margin-block: var(--space-s);
  }
  .prow__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5em;
    font-family: var(--font-sans);
    font-size: var(--step--2);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .prow__sep {
    color: var(--line-strong);
  }

  @media (min-width: 60rem) {
    .prow__link {
      grid-template-columns: 70fr 30fr;
      align-items: center;
      gap: clamp(1.5rem, 4vw, 3.5rem);
    }
    /* flipped rows put the image on the right — mirror the columns so the
       image keeps the wide 70fr track, not the narrow one */
    .prow.is-flipped .prow__link {
      grid-template-columns: 30fr 70fr;
    }
    .prow.is-flipped .prow__media {
      order: 2;
    }
    .prow.is-flipped .prow__body {
      text-align: right;
    }
    .prow.is-flipped .prow__rule {
      margin-left: auto;
    }
    .prow.is-flipped .prow__tags {
      justify-content: flex-end;
    }
  }
</style>
