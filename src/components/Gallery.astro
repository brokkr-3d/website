---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  images: { src: ImageMetadata; alt: string }[];
}
const { images } = Astro.props;
---

{
  images.length > 0 && (
    <div class="gallery">
      {images.map((img, i) => (
        <figure
          class:list={["gallery__item", { "gallery__item--wide": img.src.width >= img.src.height }]}
        >
          <Image
            src={img.src}
            alt={img.alt}
            widths={[600, 900, 1400, 2000]}
            sizes="(min-width: 60rem) 60rem, 92vw"
            loading={i === 0 ? "eager" : "lazy"}
          />
          {img.alt && <figcaption>{img.alt}</figcaption>}
        </figure>
      ))}
    </div>
  )
}

<style>
  .gallery {
    display: grid;
    gap: var(--space-m);
  }
  .gallery__item {
    margin: 0;
  }
  .gallery__item :global(img) {
    width: 100%;
    height: auto;
    background: var(--paper-dim);
    border-radius: var(--radius);
  }
  figcaption {
    margin-top: var(--space-2xs);
    font-family: var(--font-sans);
    font-size: var(--step--2);
    color: var(--ink-faint);
  }
  @media (min-width: 48rem) {
    .gallery {
      grid-template-columns: 1fr 1fr;
    }
    .gallery__item--wide {
      grid-column: 1 / -1;
    }
  }
</style>
